{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [".pnpm-store", ".svelte-kit", "build", "node_modules", "pnpm-lock.yaml"],
  "sortImports": {
    "ignoreCase": false,
    "newlinesBetween": false,
    "customGroups": [{ "groupName": "lib", "elementNamePattern": ["${app,env,lib}/**"] }],
    "groups": [
      "type-builtin",
      "builtin",
      ["type-external", "external"],
      "lib",
      ["type-parent", "parent"],
      ["type-sibling", "type-index", "sibling", "index"],
      "unknown"
    ]
  },
  "svelte": true
}
