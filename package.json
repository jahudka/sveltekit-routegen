{
  "name": "sveltekit-routegen",
  "version": "0.5.0",
  "keywords": [
    "routing",
    "svelte"
  ],
  "homepage": "https://github.com/jahudka/sveltekit-routegen",
  "bugs": {
    "url": "https://github.com/jahudka/sveltekit-routegen/issues"
  },
  "license": "MIT",
  "maintainers": [
    {
      "name": "Eliška Daniela Kaderová",
      "email": "me@subsonic.cz",
      "url": "https://github.com/jahudka"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jahudka/sveltekit-routegen.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./codegen": {
      "types": {
        "require": "./dist/codegen/sveltekit-routes.d.cts",
        "import": "./dist/codegen/sveltekit-routes.d.mts"
      },
      "default": {
        "require": "./dist/codegen/sveltekit-routes.cjs",
        "import": "./dist/codegen/sveltekit-routes.js"
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite dev",
    "oxlint": "oxlint",
    "oxlint:fix": "oxlint --fix",
    "oxfmt": "oxfmt --check",
    "oxfmt:fix": "oxfmt --write",
    "lint": "pnpm run '/^(oxlint|oxfmt)$/'",
    "format": "pnpm run --sequential '/^(oxlint|oxfmt):fix$/'",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build && svelte-package && vite build --config vite.codegen.ts",
    "publint": "publint"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pluggable-codegen": "^0.5.1",
    "publint": "^0.3.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2 || ^3",
    "pluggable-codegen": "^0.5.1",
    "svelte": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
